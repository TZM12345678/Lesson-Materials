<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Book a Service</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
</head>
<body>
  <%- include('partials/navbar') %>

  <main class="container mt-5">
    <div class="d-flex justify-content-between align-items-center mb-4">
      <h2>Book a Pet-Care Service</h2>
      <a href="/bookings" class="btn btn-outline-primary">Booking History</a>
    </div>

    <% if (messages.length > 0) { %>
      <% messages.forEach((message) => { %>
        <div class="alert alert-success" role="alert"><%= message %></div>
      <% }); %>
    <% } %>
    <% if (errors.length > 0) { %>
      <% errors.forEach((error) => { %>
        <div class="alert alert-danger" role="alert"><%= error %></div>
      <% }); %>
    <% } %>

    <% if (pets.length === 0) { %>
      <div class="alert alert-info">
        Add a pet before booking a service.
        <a href="/pets/new" class="alert-link">Add a pet</a>
      </div>
    <% } else if (services.length === 0) { %>
      <div class="alert alert-info">No services are currently available.</div>
    <% } else { %>
      <form action="/services/book" method="POST">
        <div class="mb-3">
          <label for="petId" class="form-label">Choose your pet</label>
          <select id="petId" name="petId" class="form-select" required>
            <option value="">-- Select a pet --</option>
            <% pets.forEach((pet) => { %>
              <option value="<%= pet.id %>" <%= selectedPetId === String(pet.id) ? 'selected' : '' %>>
                <%= pet.name %> (<%= pet.species %>)
              </option>
            <% }); %>
          </select>
        </div>

        <fieldset class="mb-3">
          <legend class="form-label">Choose a service</legend>
          <% services.forEach((service, index) => { %>
            <div class="form-check">
              <input
                class="form-check-input"
                type="radio"
                name="serviceId"
                id="service-<%= service.id %>"
                value="<%= service.id %>"
                <%= index === 0 ? 'required' : '' %>>
              <label class="form-check-label" for="service-<%= service.id %>">
                <%= service.name %> — S$<%= Number(service.price).toFixed(2) %>
              </label>
            </div>
          <% }); %>
        </fieldset>

        <div class="mb-3">
          <label for="bookingDate" class="form-label">Booking date</label>
          <input
            type="date"
            class="form-control"
            id="bookingDate"
            name="bookingDate"
            value="<%= today %>"
            min="<%= today %>"
            required>
        </div>

        <p class="text-muted">Payment will remain pending. No payment is processed when booking.</p>
        <button type="submit" class="btn btn-success">Create Booking</button>
      </form>
    <% } %>
  </main>
</body>
</html>
